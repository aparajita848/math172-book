n":1},"end":{"line":72,"column":1}},"key":"AU3MnZLKgr"}],"key":"ISmLdY7XLR"}],"key":"ADqNARbWSZ"}],"key":"JtZlPVOLLT"},{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"We translate our assumptions and ingredients into formal mathematical equations. The single most important aid in this step is ","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"qg1X9M4SfI"},{"type":"strong","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"bookkeeping","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"J0oycxmgti"}],"key":"KrVLgOCCge"},{"type":"text","value":"—the process of tracking quantities that remain conserved or invariant in the system (such as total population, mass, energy, or probability). These conservation principles often guide us toward the correct form of our equations.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"xMmQ0JgZXc"}],"key":"G0PVUa9eiU"},{"type":"list","ordered":true,"start":4,"spread":false,"position":{"start":{"line":76,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Solve and Simulate the model","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"N3dYiIJePK"}],"key":"OxDdAaFg1w"}],"key":"REGv4zHbaK"}],"key":"pMjDM1x2DN"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Since our model captures the dynamics of a system through rate equations (differential or difference equations), we need to solve these equations to observe how the system changes over time. While simpler models may have known analytical (explicit) solutions, more complex models require numerical methods and computer simulation to generate results.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"L3a8pso5Q7"}],"key":"ozGErwGWxB"},{"type":"list","ordered":true,"start":5,"spread":false,"position":{"start":{"line":80,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Analyze the Results","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"q76i5cEIRe"}],"key":"Z1WGUPPsl0"}],"key":"CsuGgVhVrx"}],"key":"e72sMBLQmn"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"We analyze our simulation results both qualitatively and quantitatively. Qualitative analysis includes studying the model’s behavior, equilibrium points, and stability. Quantitative analysis involves extracting specific numerical predictions and comparing trends. Various analytical techniques—such as stability analysis, phase plane analysis, and sensitivity analysis—help us understand the model’s behavior under different conditions.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"lFvzT14yDQ"}],"key":"hSUa0rId38"},{"type":"list","ordered":true,"start":6,"spread":false,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Validate and Refine","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"U5q27ReSC4"}],"key":"oWAgmVBijf"}],"key":"uOJVtitqlB"}],"key":"hiAG1yWtsh"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"We relate our results back to the original question and compare predictions with observed data or real-world behavior. This process is iterative: if your results fail to match reality or answer the original question satisfactorily, you must reconsider your assumptions, adjust parameters, or refine the mathematical framework. The cycle continues until the model adequately represents the system of interest.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"M8UrX4Ayf1"}],"key":"bd4An7HhEk"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Successes & Failures of Mathematical Modeling","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"YXNuluEpfI"}],"identifier":"successes-failures-of-mathematical-modeling","label":"Successes & Failures of Mathematical Modeling","html_id":"successes-failures-of-mathematical-modeling","implicit":true,"key":"UJHWzTaDXz"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Mathematical modeling is typically the result of a trade-off between ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"vZ7Plr3lBw"},{"type":"strong","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"accuracy","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"mBvO7fGdLY"}],"key":"u3IZbkipwq"},{"type":"text","value":" and ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"xh4eV3AEKh"},{"type":"strong","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"simplicity","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"cwzNzzH3yv"}],"key":"pA5vof9cfb"},{"type":"text","value":" since large, complex models may be more accurate in theory, but in practice they are hard to simulate and require many parameters that may not be available or identifiable.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"Exp2408LT5"}],"key":"SDsb59buuv"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"The modeling process is considered successful when the obtained model possesses the following characteristics:","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"G246tMQWeW"}],"key":"QUc2ua6P57"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":94,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":94,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"strong","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"Accurate:","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"wLCg4JdfA2"}],"key":"YXlLpLa6eu"},{"type":"text","value":" the model should attempt to accurately describe current existing observations.","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"RIuyiAUai1"}],"key":"m6K6vpip3J"}],"key":"hEiro6aFVT"},{"type":"listItem","spread":true,"position":{"start":{"line":96,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"strong","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"text","value":"Predictive:","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"ikW5BlrNkV"}],"key":"dgBMrf2x80"},{"type":"text","value":" the model should allow to appropriately predict the behavior of the system in situations not already observed.","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"jZ0MNOCP9u"}],"key":"xxTGMcJfN3"}],"key":"STmicXfnoZ"},{"type":"listItem","spread":true,"position":{"start":{"line":98,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"strong","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"Reusable:","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"KhBCZIdulu"}],"key":"JeiwYGqIRV"},{"type":"text","value":" the model can be adapted and applied to other similar cases or systems, demonstrating generality beyond a single specific scenario.","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"sYN9jqIX1n"}],"key":"KMaGsf9Fls"}],"key":"P10JnmLN8Z"},{"type":"listItem","spread":true,"position":{"start":{"line":100,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"strong","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Parsimonious:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"hTkk2xqDiw"}],"key":"cVnQRx1dcB"},{"type":"text","value":" the model should be as simple as possible. That is, given competing and equally good models, the simplest is preferred (Occam’s Razor).","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"g32ZpNPXJm"}],"key":"DnRhlT8LFH"}],"key":"RzispcZzj3"}],"key":"Gr6DjbbCZV"},{"type":"comment","value":"Definitions Related to Modeling Philosophy {cite}`Botsford2019`\nGenerality—strictly speaking, the quality of a statement applying to all cases.","position":{"start":{"line":102,"column":1},"end":{"line":103,"column":1}},"key":"JzIlmNusQE"},{"type":"comment","value":"Realism—having the same structural form as a real object.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"HY6jiw3df3"},{"type":"comment","value":"Precision—the quality of a statistical estimate having a narrow distribution of error about apoint, but not necessarily about the true value.","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"qNtu3a9KTW"},{"type":"comment","value":"Accuracy—the quality of a statistical estimate having a narrow distribution of error aboutthe true value.","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"gr40khb00Y"},{"type":"comment","value":"Holism—including all of the relevant factors","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"KEjjkZfpoT"},{"type":"comment","value":"Strategic models—models devised to answer very general questions about populationbehavior, with little attention to accurately portraying a specific situation.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"U1oUwhB0XG"},{"type":"comment","value":"Tactical models—models devised to answer specific questions about real situations for the purpose of making projections on which management will be based","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"JVMFiprQr9"},{"type":"paragraph","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"The two dangers inherent in the use of mathematical models are ","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"pzLEn7ISKj"},{"type":"strong","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"over-complexity","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"DqNdiDxOrr"}],"key":"kU3luY3IAt"},{"type":"text","value":" and ","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"DkOD6v8y0a"},{"type":"strong","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"confusing the model with reality","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"Ec9dd7Lkmo"}],"key":"OCVc8OLiTi"},{"type":"text","value":". When a model is too complex, it may contain variables we can never measure or mathematical solutions too intricate to interpret meaningfully or prove to be computationally, too expensive. When models become laden with excessive detail, the principal features are obscured. The most useful models are often the simplest ones that still capture the essential dynamics. The second danger is that we forget that the models are abstract representations of nature. However logical or elegant a model appears, nature is not obligated to follow its rules. Models are tools for understanding, not perfect replicas.(","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"fNlAfJaECN"},{"type":"cite","kind":"narrative","label":"Gotelli1998","identifier":"gotelli1998","children":[{"type":"text","value":"Gotelli (1998)","key":"IBCaJspPcF"}],"enumerator":"3","key":"fdwDcX0reP"},{"type":"text","value":")","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"okY62KtlVJ"}],"key":"cHesiDbzGk"},{"type":"paragraph","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"By carefully examining a model’s assumptions and limitations, we can identify where it departs from reality and make informed decisions about when and how to apply it. The key is to use models appropriately while recognizing their inherent limitations.","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"eWpAtYpd3v"}],"key":"HmkJVZbrkv"}],"key":"ykYMmSxK9b"}],"key":"zonmZA5y2I"},"references":{"cite":{"order":["Segel2013","Adler2013","Gotelli1998"],"data":{"Segel2013":{"label":"Segel2013","enumerator":"1","doi":"10.1137/1.9781611972504","html":"Segel, L. A., & Edelstein-Keshet, L. (2013). <i>A Primer on Mathematical Models in Biology</i>. Society for Industrial. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1137/1.9781611972504\">10.1137/1.9781611972504</a>","url":"https://doi.org/10.1137/1.9781611972504"},"Adler2013":{"label":"Adler2013","enumerator":"2","html":"Adler, F. R. . (2013). <i>Modeling the dynamics of life : calculus and probability for life scientists</i> (Third). Brooks/Cole, Cengage Learning."},"Gotelli1998":{"label":"Gotelli1998","enumerator":"3","html":"Gotelli, N. J. . (1998). <i>A primer of ecology</i> (A. D. Sinauer, Ed.; Second, p. 236). Sinauer Associates."}}}}}