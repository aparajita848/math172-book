 most important aid to this endeavor is what can be called **bookkeeping**. This is the process of keeping track of some quantity that remains invariant","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"jJcEdQ74ip"},{"type":"list","ordered":true,"start":2,"spread":false,"position":{"start":{"line":68,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":68,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Determine the basic ingredients","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"dcjWB4NJZX"}],"key":"LnibIgjzjU"}],"key":"F34tEPBVbA"}],"key":"wZLq1f5tO2"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"After identifying our ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"dQNnQVVvHk"},{"type":"emphasis","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"independ,ent","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"BYlrqvfEwI"}],"key":"OZIcDkI2ff"},{"type":"text","value":" and ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"Y6H4hgmsPe"},{"type":"emphasis","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"dependent","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"tiJ1rkrsRK"}],"key":"aimIEJQuRj"},{"type":"text","value":" variables, we further determine the ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"nJuCbdllJs"},{"type":"strong","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"parameters","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key